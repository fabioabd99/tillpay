# Local Postgres from docker-compose.yml.
# Host port is 5433 to avoid colliding with another Postgres on the default 5432.
DATABASE_URL=postgresql://tillpay:tillpay@localhost:5433/tillpay

BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 48
BETTER_AUTH_SECRET=
# Shared secret for the daily job (repeating payments, demo clean-up).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional: the public address, for link previews, robots.txt and the sitemap.
# On Vercel it falls back to the production URL; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=
