          "name": "recurring_rules_day_of_month",
          "value": "\"recurring_rules\".\"day_of_month\" IS NULL OR (\"recurring_rules\".\"day_of_month\" BETWEEN 1 AND 31)"
        },
        "recurring_rules_weekday": {
          "name": "recurring_rules_weekday",
          "value": "\"recurring_rules\".\"weekday\" IS NULL OR (\"recurring_rules\".\"weekday\" BETWEEN 0 AND 6)"
        }
      },
