          "value": "\n        (\"recurring_rules\".\"type\" = 'income'   AND \"recurring_rules\".\"amount_cents\" > 0) OR\n        (\"recurring_rules\".\"type\" = 'expense'  AND \"recurring_rules\".\"amount_cents\" < 0) OR\n        (\"recurring_rules\".\"type\" = 'transfer' AND \"recurring_rules\".\"amount_cents\" <> 0)\n      "
        },
